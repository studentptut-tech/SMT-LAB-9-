@page "{id:int}"
@model WebApplication3.Pages.Products.EditModel
@{
    ViewData["Title"] = "Edit Product";
}

<h1>Edit Product</h1>
<form method="post" class="mt-3">
    <input type="hidden" asp-for="Product.Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Product.Title" class="form-label"></label><input asp-for="Product.Title" class="form-control" /><span asp-validation-for="Product.Title" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Product.Description" class="form-label"></label><input asp-for="Product.Description" class="form-control" /><span asp-validation-for="Product.Description" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Product.Image" class="form-label"></label><input asp-for="Product.Image" class="form-control" /><span asp-validation-for="Product.Image" class="text-danger"></span></div>
    <div class="row"><div class="col-md-6 mb-3"><label asp-for="Product.Price" class="form-label"></label><input asp-for="Product.Price" type="number" min="0" class="form-control" /><span asp-validation-for="Product.Price" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="Product.Quantity" class="form-label"></label><input asp-for="Product.Quantity" type="number" min="0" class="form-control" /><span asp-validation-for="Product.Quantity" class="text-danger"></span></div></div>
    <div class="mb-3"><label asp-for="Product.Status" class="form-label"></label><select asp-for="Product.Status" class="form-select"><option value="Active">Active</option><option value="Inactive">Inactive</option><option value="Out of Stock">Out of Stock</option></select><span asp-validation-for="Product.Status" class="text-danger"></span></div>
    <button class="btn btn-success" type="submit">Update Product</button> <a class="btn btn-secondary" asp-page="Index">Back</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
